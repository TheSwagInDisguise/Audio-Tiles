<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth Classic & RFCOMM Permissions -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ (API 31+) Bluetooth Permissions -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Notification & Foreground Service for Android 13+ / 14+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- ColorOS Guardrail: WakeLock for Quick Settings Tile tap non-freeze -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonyXM6Controller">

        <!-- Setup & Dashboard Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Primary Quick Settings Tile Service: Noise Control Cycling -->
        <service
            android:name=".service.XM6TileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_nc"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Secondary Quick Settings Tile: Speak-to-Chat -->
        <service
            android:name=".service.SpeakToChatTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_s2c"
            android:label="@string/tile_s2c_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Secondary Quick Settings Tile: Clear Bass Stepper -->
        <service
            android:name=".service.ClearBassTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_bass"
            android:label="@string/tile_clearbass_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Secondary Quick Settings Tile: Voice Focus -->
        <service
            android:name=".service.FocusOnVoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_voice"
            android:label="@string/tile_voice_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Secondary Quick Settings Tile: Sound Quality Priority -->
        <service
            android:name=".service.SoundQualityTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_ldac"
            android:label="@string/tile_soundquality_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- App Widget: Compact 2x1 Provider -->
        <receiver
            android:name=".widget.SonyAudioCompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sony.xm6controller.widget.ACTION_CYCLE_MODE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- App Widget: Studio 4x2 Provider -->
        <receiver
            android:name=".widget.SonyAudioStudioWidgetProvider"
            android:exported="true"
            android:label="@string/widget_studio_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sony.xm6controller.widget.ACTION_SET_MODE" />
                <action android:name="com.sony.xm6controller.widget.ACTION_TOGGLE_S2C" />
                <action android:name="com.sony.xm6controller.widget.ACTION_TOGGLE_BYPASS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_studio_info" />
        </receiver>

        <!-- Foreground Service for Persistent Link / ColorOS Background Survival -->
        <service
            android:name=".service.XM6ForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
